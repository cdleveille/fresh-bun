{
  "name": "fresh-bun",
  "version": "0.1.0",
  "description": "Single-page web app project template curated for performance, developer experience, and type safety.",
  "author": "Chris Leveille",
  "license": "MIT No Attribution",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "tsc": "tsc -p tsconfig.json",
    "dev:client": "bunx --bun vite",
    "dev:server": "bun --hot src/server/app.ts",
    "dev": "bun run --parallel dev:server dev:client; stty sane",
    "build:client": "bunx --bun vite build && bun src/scripts/workbox.ts",
    "build:server": "bun src/scripts/assets.ts && NODE_ENV=production bun build --compile --minify --bytecode --target bun --outfile dist/app src/server/app.ts",
    "build:app": "bun build:client && bun build:server && bun src/scripts/clean.ts",
    "build": "bun build:app",
    "start": "bun src/server/app.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@evilmartians/lefthook": "^2.1.12",
    "@rolldown/plugin-babel": "^0.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "workbox-build": "^7.4.1"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@socket.io/bun-engine": "^0.1.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  }
}
